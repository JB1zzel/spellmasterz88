; OZ system call interface introduced in 4.2

IF !__FLASHEPR_DEF__
DEFINE __FLASHEPR_DEF__

INCLUDE "macros.def"

; Flash Memory types, generation number

defc    FE_28FSA        = 1                     ; first generation, 12V required, slot 3 mandatory
defc    FE_28FS5        = 2                     ; second generation, 5V only, all slots
defc    FE_29F          = 3                     ; third generation, JEDEC, 5V only, all slots
defc    FE_39F          = 4                     ; fourth generation, JEDEC, 5V only, , 4K sectors, all slots

; Manufacturer codes

defc    FE_INTEL_MFCD   = $89                   ; Intel
defc    FE_AMD_MFCD     = $01                   ; AMD
defc    FE_STM_MFCD     = $20                   ; STMicroelectronics
defc    FE_AMIC_MFCD    = $37                   ; AMIC
defc    FE_MACRONIX_MFCD = $C2                  ; Macronix
defc    FE_SST_MFCD     = $BF                   ; SST
defc    FE_EON_MFCD     = $1C                   ; EON
defc    FE_HY_MFCD      = $AD                   ; hynix

; Intel
; G1 : 28FxxxSA requires 12V for programming and erasure in slot 3 only
defc    FE_I28F008SA    = $89A2                 ; 1Mb memory, 16 x 64K erasable sectors, 64 x 16K banks

; Intel
; G2 : 28FxxxS5 requires 5V only, programming and erasure in all slots
defc    FE_I28F004S5    = $89A7                 ; 512Kb memory, 8 x 64K erasable sectors, 32 x 16K banks
defc    FE_I28F008S5    = $89A6                 ; 1Mb memory, 16 x 64K erasable sectors, 64 x 16K banks

; AMD
; G3 : JEDEC, 5V only, 64K sectors
defc    FE_AM29F010B    = $0120                 ; 128Kb memory, 8 x 16K erasable sectors, 8 x 16K banks
defc    FE_AM29F040B    = $01A4                 ; 512Kb memory, 8 x 64K erasable sectors, 32 x 16K banks
defc    FE_AM29F080B    = $01D5                 ; 1Mb memory, 16 x 64K erasable sectors, 64 x 16K banks 
defc    FE_AM29F032D    = $01F9                 ; 4Mb memory, model 04, seen as 4 x 1Mb (3V)

; STMicroelectronics
; G3 : JEDEC, 5V only, 64K sectors
defc    FE_ST29F040B    = $20E2                 ; 512Kb memory, 8 x 64K erasable sectors, 32 x 16K banks
defc    FE_ST29F080D    = $20F1                 ; 1Mb memory, 16 x 64K erasable sectors, 64 x 16K banks

; AMIC
; G3 : JEDEC, 5V only, 64K sectors
defc    FE_AMIC29040C   = $3786                 ; 512Kb memory, 8 x 64K erasable sectors, 32 x 16K banks
defc    FE_AMIC29L040   = $3792                 ; 512Kb memory, 8 x 64K erasable sectors, 32 x 16K banks (3V)

; Macronix
; G3 : JEDEC, 5V only, 64K sectors
defc    FE_MX29F040C    = $C2A4                 ; 512Kb memory, 8 x 64K erasable sectors, 32 x 16K banks
defc    FE_MX29F080     = $C2D5                 ; 1024Kb memory, 16 x 64K sectors, 64 x 16K banks

; EON
; G3 : JEDEC, 5V only, 64K sectors
defc    FE_EN29LV040A   = $1C4F                 ; 512Kb memory, 8 x 64K erasable sectors, 32 x 16K banks (3V)

; Hyundai/Hynix
; G3 : JEDEC, 5V only, 64K sectors
defc    FE_HY29F080     = $ADD5                 ; 1M, 16x64K sectors, 5V
defc    FE_HY29F040A    = $ADA4                 ; 512K, 8x64K sectors, 5V

; SST
; G4 : JEDEC, 5V only, 4K sectors
defc    FE_SST39SF040   = $BFB7                 ; 512Kb memory, 128 x 4K erasable sectors, 32 x 16K banks

ENDIF

lston
