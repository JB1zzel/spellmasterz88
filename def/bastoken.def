	DEFC 	BE_FORVAR 	= 34			; FOR variable
	DEFC 	BE_NOTO 	= 36			; No TO
	DEFC 	BE_NOGOSUB 	= 38			; No GOSUB
	DEFC 	BE_ONSNTX 	= 39			; ON syntax
	DEFC 	BE_ONRANGE 	= 40			; ON range
	DEFC 	BE_NSLINE 	= 41			; No such line
	DEFC 	BE_OODATA 	= 42			; Out of data
	DEFC 	BE_NOREPT 	= 43			; No REPEAT
	DEFC	BE_HARSH	= 45 			; Missing #
