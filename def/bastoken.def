	DEFC	BE_NOPROC	= 13			; No PROC
	DEFC	BE_ARRAY	= 14			; Array
	DEFC 	BE_SUBSCR 	= 15			; Subscript
	DEFC	BE_SYNTAX	= 16			; Syntax
	DEFC	BE_ESC		= 17			; Escape
	DEFC 	BE_DVZ		= 18 			; Division by zero
