; Comments added to code:
{
	($C000,< "Spell-Master for the Cambridge Z88 - bank 63 ($3F, SPELL.63). Card header, front DOR, both application DORs, QuickEdit menu text,"
		 "the WordFinder application and the routines QuickEdit calls through the far-call table."
		 "Annotated disassembly made with DZasm (project spell63.clt). It assembles to bytes IDENTICAL to bank_files/spell63.bin (the original ROM bank with the bank-addressing fix: 7 bytes changed)."
		 "Offsets $0000-$003A and $0196-$01D0 are the application DORs. Names and comments are inferred, not original. See NOTES.md.")
	($C001,< "QuickEdit application DOR. Kept as raw bytes because DZasm V0.36 masks the topic, command and help pointers with $3FFF, but this card stores them as full $Cxxx addresses."
		 "$C001 parent link 00 00 00; brother link 96 01 3F = offset $0196, bank $3F (the WordFinder DOR); son link 00 00 00."
		 "$83 = application ROM DOR, length $2F. '@' = info section, length $12:"
		 "reserved 00 00; key letter 'Q'; contiguous RAM size $FF (only used by bad applications); overhead 0; unsafe workspace $001A; safe workspace $0062;"
		 "entry point $C000; bindings S0 to S3 = 00 00 00 3E (code bank $3E = SPELL.62 in segment 3); type 1 = $01 (AT_GOOD, an ordinary application); type 2 = $00."
		 "'H' = help section, length $0C: topics $E6EB, commands $E728, application help $EAB5 (all bank $3F), tokens 00 00 00 (none)."
		 "'N' = name section, length 10: QuickEdit, 0. Then $FF ends the DOR.")
	($C03B,< "Copy of bank 62 read_dictionary_record (see there).")
	($C070,< "Copy of bank 62 skip_to_next_letter_group.")
	($C087,< "Same routine as find_dictionary_section in bank 62.")
	($C0BF,< "Same routine as in bank 62: bind one dictionary bank into segment 2 (see bank 62 for the description)."
		 "BANK-ADDRESSING SITE 1 (patched, copy in this bank): ADD A,D / SUB $3F, where D = $38 + index. The ORIGINAL ROM had AND $C0 / OR D.")
	($C0EB,< "Same routine as next_word_form in bank 62: the next accepted word form in buffer C (next ending, or next record expanded). Carry set at the end of the section.")
	($C196,< "WordFinder application DOR (raw bytes for the same reason as the QuickEdit DOR)."
		 "$C196 parent link 0; brother link 0 (last application on the card); son link 0. $83 = application ROM DOR, length $30. '@' = info section, length $12:"
		 "reserved 00 00; key letter 'W'; contiguous RAM size 0; overhead 0; unsafe workspace $007C; safe workspace 0; entry point $C1D1;"
		 "bindings S0 to S3 = 00 00 00 3F (code bank $3F = SPELL.63 in segment 3); type 1 = $09 (AT_GOOD + AT_POPD: a popdown, closed when you switch application); type 2 = $02 (AT2_ICL: inverted caps lock on entry)."
		 "'H' = help section: topics $EBA0, commands $EBAE, application help $EAB5 (shared with QuickEdit), tokens none. 'N' = name section: WordFinder, 0. Then $FF.")
	($C1D1,< "WordFinder entry point (WordFinder DOR: entry $C1D1, segment 3 = bank $3F = SPELL.63).")
	($C1D6,< "WordFinder start-up: creates pools, allocates buffers, then falls into the menu.")
	($C24B,< "Draws the WordFinder window and menu ('Browse through dictionary', 'Find anagrams', 'Find close matches', 'Solve crossword').")
	($C267,< "WordFinder menu loop: reads keys. Keys 1 to 4 choose an option, Cursor up/down moves wf_menu_sel,"
		 "Enter runs the selected option, Escape frees the pools and exits (OS_Bye).")
	($C2C7,< "Handles a key typed in the WordFinder menu.")
	($C31B,< "RC_Quit: closes the three memory pools and leaves WordFinder with OS_Bye.")
	($C3EE,< "Prints the found word (the two section letters, then buffer C) in 16-column slots, four to a 64-column row, using cursor_index and cursor_row (borrowed) as column and row."
		 "After six rows: 'Press SPACE to continue'. Any key clears the window and goes on; an extended Escape stops the search (carry set).")
	($C46E,< "After an OS_In error: if it is RC_Quit ('g', $67) leaves WordFinder (wf_quit); otherwise returns.")
	($C476,< "Opens the 'Words found' dialog (wide window) and clears cursor_row and cursor_index.")
	($C4B8,< "GN_Sip into buffer A (32 bytes, 32 columns). Out: dict_target_length = the length typed; A = the key that ended the input (Escape returns to the menu).")
	($C4DB,< "Shows 'Bad character in word' and waits for a key (end_of_search).")
	($C506,< "Option 4: the pattern may use letters, an apostrophe, '#' (any one letter) and '*' (any run of letters, including none). Other characters: 'Bad character in word'."
		 "If the pattern starts with letters only the matching sections are searched. Matching backtracks to the last '*' on a mismatch (line_rec_ptr, $1FEB, $1FBC, $1FBD)."
		 "Unlike Find anagrams this search does not stop for a key press; only the 'Press SPACE' page prompt can end it early."
		 "Menu option 4: Solve crossword (window title 'Crossword').")
	($C576,< "WordFinder reuses the line_rec_ptr word ($1FE8) here: in the crossword solver it holds a pointer into the pattern"
		 "(set after a '*' or '#' at $C5C4, 0 = none), not a line record. Likewise $1FEB holds a pointer into the dictionary word.")
	($C62D,< "Menu option 2: Find anagrams (window title 'Anagram'). Asks for a word, checks it is letters only, then searches.")
	($C6F4,< "Shows 'Press SPACE to continue' and waits for a key before going back to the menu.")
	($C709,< "$C709-$C711 are code left as data, and nothing calls them: SCF / RET, then PUSH AF / LD A,7 / OS_Out / POP AF / RET (a beep).")
	($C712,< "Sorts the B letters at HL into alphabetical order (a simple exchange sort). Find anagrams sorts the typed word once, then each dictionary word of the same length, and compares.")
	($C799,< "Far-call table entry 7."
		 "Called by draw_text_window (bank 62), which redraw_screen calls. Draws the text in window 1: the cursor line from the edit buffer,"
		 "then the rows above and below it by following the line records, then the End of text marker and blank rows."
		 "Redraw the text window (far-call routine 7). The text is a chain of line records in banked memory:"
		 "+0 = record length (text length + LINE_HDR_SIZE), +1..+3 = previous line (bank, offset low, offset high),"
		 "+4..+6 = next line (bank, offset low, offset high), +7 = the text."
		 "The cursor line itself is in the edit buffer. top_line = cursor_line - cursor_row."
		 "Algorithm: 1) draw the cursor line; 2) walk back from it row by row to find the line for row 0;"
		 "3) draw rows 0 to 7 in order, copying each line to the window and padding with spaces, following the next-line pointers;"
		 "4) after the last line draw the End of text marker and blank any rows that remain."
		 "It appears to check for a waiting key with OS_Xin and stop early if there is one, so typing is not held up by a redraw.")
	($C7C5,< "Draw the cursor line at row cursor_row in window 1, straight from the edit buffer (line_buffer)."
		 "First works out the horizontal scroll: if cursor_index is at or beyond cursor_col_limit the line is shifted left"
		 "by cursor_index - cursor_col_limit characters. Then prints the visible part and pads the row with spaces.")
	($C93D,< "Redraw finished: set the redraw state in edit_flags to 4.")
	($C948,< "Print one text character in window 1. Printable characters go straight out with OS_Out."
		 "A control character (below 32) is shown as the matching letter (code + 64) in reverse video.")
	($C96D,< "Draw the End of text marker row in reverse video ( End of text ), then fall into clear_remaining_rows.")
	($C992,< "Blank every remaining row of the text window below the End of text marker, up to row 7.")
	($C9D9,< "Turn reverse video on.")
	($C9E5,< "Turn reverse video off.")
	($C9FC,< "Put the block markers in order: if both markers are set and the end comes before the start, swap start and end."
		 "marker_flags bit 0 = start set, bit 1 = end set; the markers are a line number plus a column.")
	($CA36,< "Highlight the part of the marked block that falls on the row just drawn, using the toggle-over-N sequence with reverse video.")
	($CB05,< "Copy of bank 62 expand_word, with append_token inline (its own token table at $CC73).")
	($CC73,< "Bank 63 copy of the 128-word token pointer table (bank 62: $C4A4).")
	($CD87,< "Shows: the text filename (text_name_ptr), number of lines, free memory in K (NQ_Mfs, divided by 4: the result is in 256-byte pages), word count,"
		 "and the user dictionary filename (or 'None'). A word is a run of letters and apostrophes, so numbers are not counted."
		 "The line and word counts walk the whole text and are left out if a key is pressed while counting (OS_Xin). top_line is borrowed as the word counter."
		 "Far-call table entry 0."
		 "Called from the QuickEdit handler for Information (command $1A)."
		 "Shows the Information window ('Currently editing', number of lines, memory, word count, user dictionary).")
	($CEB4,< "Prints the filename kept in the record HL (bank B): text_name or user_dict_name. Prints 'None' if HL = 0.")
	($CED7,< "NZ if A is a letter or an apostrophe, Z otherwise (the opposite sense to is_word_char in bank 62). Used to count words.")
	($CFA5,< "Prints HL in decimal, using the table of powers of ten at $CFDA (leading zeros suppressed). Borrows $1FBC and line_counter.")
	($CFE6,< "Runs far-call routine number A: pops the index, looks it up in far_call_table, calls it, then returns to bank 62."
		 "Entered from the stub at $7F80 with this bank bound into segment 3.")
	($D008,< "Far-call table: 11 words, indexed by the value in A when QuickEdit (bank 62) calls far_call_bank63."
		 "Index 1 (find_next_match, $D54F) and index 5 (far_call_5_unused, $DB25) are not used by any caller in bank 62; find_next_match is called directly inside this bank.")
	($D01E,< "Tab stops are every 8 columns. If the characters up to the next stop are all spaces the cursor just moves over them (returns A = 1);"
		 "otherwise enough spaces are inserted to reach the stop, and block markers to the right on this line move with the text. (Insert real tab, command $2D, inserts a $09 instead.)"
		 "Far-call table entry 8."
		 "Called from the QuickEdit handler for Tab (command $29).")
	($D100,< "Enables Escape detection (OS_Esc SC_ENA), sends $05 '[' to the printer filter, then every line of the whole text followed by LF CR (through OS_Prt),"
		 "then $05 ']' and disables Escape detection again (SC_DIS). An error from OS_Prt (for example Escape) beeps and ends the printout."
		 "The $05 '[' and $05 ']' pairs appear to mark the start and end of the job for the printer filter. Tabs and control characters are sent as they are."
		 "Far-call table entry 10."
		 "Called from the QuickEdit handler for Print out text (command $2E)."
		 "Shows the 'Printing' window and sends the text to the printer.")
	($D174,< "OS_Prt returned an error: beep and finish the printout.")
	($D19D,< "Asks 'Global or selective ? (G/S)': selective sets $1FB3 bit 7, global clears it. Then Find and Replace (each up to 63 characters, the last ones offered again;"
		 "up and down move between the two fields). Both strings are saved (search_str_ptr, replace_str_ptr). For each match (find_next_match), in selective mode the text is redrawn"
		 "and 'Replace ? (Y/N)' asked: N moves on one character, Escape stops. A replacement is refused (the search ends) if it would make the line 240 ($F0) characters or longer."
		 "The replacement may also run over the end of a line, matching how find_next_match crosses lines. Afterwards QuickEdit rewraps the whole text ($DBD3 in bank 62)."
		 "Far-call table entry 3."
		 "Called from the QuickEdit handler for Search and Replace (command $26).")
	($D479,< "Next Match reloads the saved search string and searches again from one character after the cursor."
		 "Far-call table entry 9."
		 "Called from the QuickEdit handler for Next Match (command $2C).")
	($D498,< "Far-call table entry 2."
		 "Called from the QuickEdit handler for Search for string (command $25).")
	($D4D8,< "Saves buffer A as the search string (search_str_ptr/bank) and runs find_next_match; then places cursor_row (row 3, or the line number near the top). Used by Search and by Next Match.")
	($D54F,< "Far-call table entry 1 (not used through the table). Searches from the cursor for the string in buffer A (zero-terminated)."
		 "The comparison is exact, so the search is case-sensitive. A match may run on past the end of a line: the comparison continues at the start of the next line."
		 "Found: carry clear, cursor_line and cursor_index at the start of the match (top_line and $1FE4 are borrowed for the line and column where the attempt started)."
		 "Not found: carry set. The lines already searched are not walked back, so the cursor is left at the end of the text.")
	($D5DB,< "Walks back from cursor_line to the line in top_line (where the current match attempt started) and makes it the cursor line.")
	($D600,< "$D600-$D74F: copies of the bank 62 line-record routines, used by the far-called commands (see notes section 12, 'How the text is stored').")
	($D61A,< "Same as load_line_record in bank 62: copies the record at line_rec into the edit buffer and takes its links as prev_line and next_line."
		 "It does not free the record: bank 63 has no take_line_record, and every caller follows it with free_line_record.")
	($D756,< "$D756-$D765 (16 bytes) are code, left as data because nothing calls them: an unused copy of check_free_memory"
		 "(LD BC,NQ_Mfs / LD IX,(pool_main) / OS_Nq / CP 0 / RET NZ / LD A,B / CP 5 / RET). The bank's own copy is at $DAD1.")
	($D7AA,< "Copies the zero-terminated string at HL into a new record from pool_main (byte 0 = record size). Out: HL = offset, A = bank (also in line_rec)."
		 "The OS_Mal result is not checked for an error.")
	($D7DD,< "Frees a record whose byte 0 is its size (HL = offset, A = bank); does nothing if HL = 0. Same as free_sized_record in bank 62.")
	($D7F2,< "Copies the string saved in the record HL (bank A) to DE, so the last Find or Replace string is offered again; an empty string if HL = 0.")
	($D862,< "Same routine as section_could_match in bank 62 (identical bytes).")
	($D880,< "Far-call table entry 6."
		 "Called from append_guess (bank 62 $E076) by Guess correct word, once for each dictionary or user word that is one edit away from the typed word."
		 "Allocates a record of (word length + 7) bytes and appends it to the guess list: byte 0 = word length, bytes 1-3 = previous guess, bytes 4-6 = next guess (0), then the whole word from buffer C - 2."
		 "The first guess becomes the list head (guess_list_ptr/bank); $1FBC/$1FBE hold the last guess, $1FBF/$1FC1 the new one. Carry set if there is no room.")
	($D909,< "Merge text at cursor: reads the file like Load text (lines end at CR, at most 239 characters) and inserts the lines at the cursor."
		 "Unlike Load text it does not recognise the '%CO:A,72,72%' header, so that line is merged as ordinary text. It checks free memory before each line"
		 "(check_free_memory) and stops when memory is nearly full. If the file cannot be opened it only beeps."
		 "Far-call table entry 4."
		 "Called from the QuickEdit handler for Merge text at cursor (command $27).")
	($DA23,< "GN_Sip into buffer A (50 bytes, 15 columns shown).")
	($DAD1,< "Same routine as check_free_memory in bank 62: carry set when memory is nearly full.")
	($DB06,< "Prints a short sequence that selects window 1 again (1 H 1 ...), used before redrawing the text.")
	($DB25,< "Far-call table entry 5. Nothing calls it: bank 62 never uses index 5 and nothing in this bank jumps here."
		 "It and the routines only it uses ($DB25-$DCFD, about 470 bytes) look the word in buffer A up in the dictionary, positioning at the first word not before it,"
		 "and also consult the user dictionary (user_dict_ptr). Probably left over from an earlier design. The 'Opened file' string at $DB17 is not used either.")
	($DCFE,< "Option 3 uses the same test as Guess correct word (section_could_match, is_one_edit_away) over the whole ROM dictionary, without the user dictionary and without stopping for a key press."
		 "Menu option 3: Find close matches (window title 'Find close matches').")
	($DD8A,< "Same routine as is_one_edit_away in bank 62 (identical apart from the jump addresses): Z if the word is one letter different, missing, extra or swapped.")
	($E203,< "Option 1 is the bank 62 Browse (browse_dictionary) almost instruction for instruction: same keys, same routines (names as in bank 62),"
		 "except that it starts at 'AA' instead of the typed word and calls no_user_word where QuickEdit looks in the user dictionary."
		 "Menu option 1: Browse through dictionary.")
	($E5DB,< "Stands in for the user dictionary lookups of the bank 62 Browse (L_F9DF, L_FADE): clears $1FB3 bit 1 and returns carry (no user word). WordFinder has no user dictionary.")
	($E5E5,< "Same routine as next_full_word in bank 62: next_word_form, with the two section letters written just before buffer C.")
	($E6EB,< "QuickEdit menu topics ('Blocks', 'Cursor', 'Edit', 'Files', 'SPELLING') - kept as raw bytes.")
	($E728,< "QuickEdit menu commands: 46 commands, each [length][code][key bytes][0][name][0][length]. See NOTES.md for the full table.")
	($EBAE,< "Menu commands for the Correction/spelling menu.")
	($EC5D,< "Titled dialog x 25, 30 columns, full height (as open_dialog_centre in bank 62).")
	($EC62,< "Titled dialog x 5, 70 columns, full height ('Words found').")
	($EC67,< "Titled dialog x 18, 44 columns, full height.")
	($EC6C,< "Titled dialog x 20, 40 columns, full height (the WordFinder option windows: Anagram, Find close matches, Crossword).")
	($EC71,< "Titled dialog x 40, 35 columns, rows 1-7 (Browse).")
	($EC90,< "Same routine as open_dialog_with_title in bank 62. In: HL = title, BC = window description.")
	($FF80,< "STUB entered from bank 62 (far_call_bank63): copies the bank bound in segment 1 (this bank) into segment 3"
		 "and jumps to far_call_dispatch.")
	($FF8B,< "STUB used on the way back: re-binds bank 62 into segment 3, restores the registers saved on the stack, RET."
		 "BANK-ADDRESSING SITE 3 (patched): bank 62 is the bank before bank 63, so DEC A replaces the original AND $C0 / OR $3E. Shown here as raw bytes:"
		 "$0E,$01 LD C,1 / $E7,$5A OS_Mgb / $78 LD A,B / $3D DEC A / $00,$00,$00 NOPs (ORIGINAL: $E6,$C0 AND $C0 / $F6,$3E OR $3E) / $47 LD B,A / $0E,$03 LD C,3 / $E7,$5D OS_Mpb / POPs / RET.")
}

