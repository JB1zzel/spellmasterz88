	$1FD9 user_dict_name_bank, $1FDA ignore_list_ptr, $1FDC ignore_list_bank, $1FE3 own_header_flag, $1FE4 char_scratch, $1FE5 line_counter, $1FE7 pull_count, $1FE8 line_rec_ptr
