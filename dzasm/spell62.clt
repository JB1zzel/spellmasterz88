	- ; 'dor.def'
	+ ; 'syspar.def'
	- ; 'saverst.def'
	- ; 'fpp.def'
	- ; 'integer.def'
	- ; 'serintfc.def'
	- ; 'screen.def'
	- ; 'time.def'
	- ; 'char.def'
	+ ; 'error.def'
	- ; 'map.def'
